# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# local session/runtime state - not project content, changes every run
.claude/scheduled_tasks.lock
# per-developer Claude Code tool-permission allowlist - local config, not TURU product source
# (narrow on purpose: the rest of .claude/ stays tracked and shared)
.claude/settings.local.json
supabase/.temp/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# one-time script run output (logs/CSVs/audit JSON/checkpoints) - not source, regenerated per-run
tools/import-tool/*.log
tools/import-tool/logs/
tools/import-tool/_playground-name-migration-audit-*.json
tools/import-tool/_final_examples*.txt
tools/import-tool/_audit_sample.txt
# generated operational / forensic reports (row ids, dry-runs, applied mutations, rollbacks) - kept
# privately, never published. Scoped to tools/import-tool so *.cases.json, reference/*.json,
# supabase/functions/_shared/*.json, i18n locales and test fixtures stay tracked.
tools/import-tool/**/*-applied.json
tools/import-tool/**/*-dryrun.json
tools/import-tool/**/*-dryrun-*.json
tools/import-tool/**/*-dry-run-*.json
tools/import-tool/**/*-rollback.json
tools/import-tool/**/*-deps.json
tools/import-tool/**/*-measure.json
tools/import-tool/**/coverage-report-*.json
tools/import-tool/**/cleaner-report-*.json
tools/import-tool/**/service-area-audit-*.json
tools/import-tool/**/service-area-cohort-*.json
tools/import-tool/**/discovery-candidates-*.json
tools/import-tool/**/reprobe-sources-*.json
tools/import-tool/**/monster-cohort-*.json
tools/import-tool/**/monster-cycle-*.json
tools/import-tool/reports/*.json
tools/import-tool/reports/*-dry-run-*.md
# generated google-origin backfill SQL (row ids + source-url hashes) - private, like the reports above
tools/import-tool/**/google-origin-backfill-*.sql
tools/playground-discovery/*.log
tools/playground-discovery/*.csv
tools/playground-discovery/*.jsonl
tools/playground-discovery/*.json
tools/playground-discovery/_*.txt
tools/playground-discovery/checkpoint.json
tools/playground-discovery/__pycache__/
_all_cities_raw.json
_merged_city_candidates.txt
_categories_list.txt
_audit_sample.txt
