# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# local session/runtime state - not project content, changes every run
.claude/scheduled_tasks.lock
supabase/.temp/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# one-time script run output (logs/CSVs/audit JSON/checkpoints) - not source, regenerated per-run
tools/import-tool/*.log
tools/import-tool/_playground-name-migration-audit-*.json
tools/import-tool/_final_examples*.txt
tools/import-tool/_audit_sample.txt
tools/playground-discovery/*.log
tools/playground-discovery/*.csv
tools/playground-discovery/*.jsonl
tools/playground-discovery/*.json
tools/playground-discovery/_*.txt
tools/playground-discovery/checkpoint.json
tools/playground-discovery/__pycache__/
_all_cities_raw.json
_merged_city_candidates.txt
_categories_list.txt
_audit_sample.txt
