# TuRu playground/park discovery - copy this file to .env and fill in the key.
#
# Google Maps Platform API key with "Places API (New)" enabled + billing set up.
# Never commit the real .env file (it's already covered by the project's
# top-level .gitignore pattern for .env files - same as tools/import-tool/.env).
GOOGLE_MAPS_API_KEY=

# Supabase credentials are NOT duplicated here - this script reads them
# straight from tools/import-tool/.env (SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_BOT_EMAIL, SUPABASE_BOT_PASSWORD), the same bot account every other
# import tool in this project already uses. Only needed at all when running
# with --import-supabase.
