{
  "expo": {
    "name": "תורו",
    "slug": "wabbit",
    "scheme": "wabbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.turu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#c2ecfe"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermissionText": "TuRu משתמשת במיקום שלכם כדי להראות פעילויות קרובות אליכם."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TuRu משתמשת בזיהוי הפנים שלכם כדי לחבר אתכם מהר יותר בפעם הבאה."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TuRu צריכה גישה לתמונות שלכם כדי שתוכלו להוסיף תמונות מהפעילות.",
          "cameraPermission": "TuRu צריכה גישה למצלמה כדי שתוכלו לצלם תמונה מהפעילות."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e47bcbd6-1ffd-4896-91c1-d764aad9b602"
      }
    }
  }
}
