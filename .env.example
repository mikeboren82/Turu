# העתק קובץ זה ל-.env (בלי הסיומת .example) - זה המפתח הציבורי, בטוח לחשוף בצד הלקוח
EXPO_PUBLIC_SUPABASE_URL=https://kkvgzubwsjsbqxzjejcs.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# דומיין הייצור הציבורי של גרסת ה-Web (בלי / בסוף) - נדרש כדי שקישורי שיתוף (למשל שיתוף פעילות
# דרך WhatsApp, ראו lib/shareActivity.js) יפתחו כדף פעילות תקין בדפדפן כשהאפליקציה לא מותקנת.
# בלי זה: ב-Web משתמשים ב-origin של הדף עצמו כשהוא https (האתר המאורח כבר כתובת ציבורית), אבל
# באפליקציה (Android/iOS) קישורי השיתוף חוזרים ל-deep link בסכמה (wabbit://...) - פותח את האפליקציה
# כשהיא מותקנת, אבל לא עובד כקישור-אינטרנט רגיל. EXPO_PUBLIC_* מוטמע בזמן build, אז לבניות EAS הוא
# צריך להיות גם ב-env של הפרופיל ב-eas.json, לא רק כאן. דוגמה: EXPO_PUBLIC_SITE_URL=https://wabbit.expo.app
EXPO_PUBLIC_SITE_URL=
